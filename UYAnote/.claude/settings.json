{
  "permissions": {
    "allow": [
      "Bash(py -3 .claude/hooks/buffer_api.py metrics*)",
      "Bash(python .claude/hooks/buffer_api.py metrics*)",
      "Edit(3_広報部/X反響記録.md)",
      "Write(3_広報部/分析レポート/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_guard.sh\" --reset"
          }
        ]
      }
    ]
  }
}
